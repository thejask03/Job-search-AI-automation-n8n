        "jsCode": "// Deduplicate against BOTH this run's batch and everything already logged in the\n// tracker (via the 'Microsoft Excel (Get Seen Job IDs)' branch), then normalize\n// schema across all sources (no network / no crypto import).\nconst seenIds = new Set();\nconst rawItems = [];\n\nfor (const item of $input.all()) {\n  const data = item.json || {};\n  if (data._seen) {\n    if (data.job_id) seenIds.add(String(data.job_id).toLowerCase());\n    continue;\n  }\n  rawItems.push(data);\n}\n\nconst batchSeen = new Set();\nconst results = [];\n\nfor (const data of rawItems) {\n  const title = data.title || data.text || '';\n  const company = data.company || data.company_name || 'Direct ATS';\n  if (!title) continue;\n\n  const key = (company + '_' + title).toLowerCase().trim();\n  let hash = 0;\n  for (let i = 0; i < key.length; i++) {\n    hash = ((hash << 5) - hash + key.charCodeAt(i)) | 0;\n  }\n  const jobId = 'job_' + Math.abs(hash).toString(16);\n\n  if (batchSeen.has(jobId) || seenIds.has(jobId)) continue; // already in this batch or already tracked from a prior run\n  batchSeen.add(jobId);\n\n  results.push({\n    json: {\n      job_id: jobId,\n      title: title,\n      company: company,\n      url: data.absolute_url || data.hostedUrl || data.url || '',\n      description: data.content || data.description || '',\n      location: (data.location && data.location.name) || (data.categories && data.categories.location) || data.location || 'Remote',\n      source_platform: data.source_platform || 'apify',\n    },\n  });\n}\n\nreturn results;"
      },
