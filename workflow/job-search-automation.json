      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Drop newsletters, receipts, and automated no-reply spam\nconst blacklist = ['newsletter', 'marketing', 'receipt', 'order', 'promo', 'no-reply', 'noreply'];\nconst from = ($json.from || '').toLowerCase();\nconst subject = ($json.subject || '').toLowerCase();\n\nconst isSpam = blacklist.some(word => from.includes(word) || subject.includes(word));\n\nif (isSpam) {\n  return null;\n}\nreturn { json: $json };"
      },
