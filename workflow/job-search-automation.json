    {
      "parameters": {
        "jsCode": "// Each ATS wraps its jobs differently (Greenhouse/Ashby: { jobs: [...] }, Lever: raw array).\n// Flatten every platform into one job-per-item shape and stamp the company back on,\n// since the HTTP response itself usually doesn't repeat the company name.\nconst targets = $('Target Companies (ATS Boards)1').all();\nconst responses = $input.all();\nconst results = [];\n\nfor (let i = 0; i < responses.length; i++) {\n  const meta = (targets[i] && targets[i].json) || {};\n  const body = responses[i].json || {};\n  let jobs = [];\n\n  if (body.error) continue; // failed fetch (bad/placeholder token) - skip quietly\n\n  if (meta.platform === 'lever') {\n    jobs = Array.isArray(body) ? body : [];\n  } else {\n    jobs = Array.isArray(body.jobs) ? body.jobs : [];\n  }\n\n  for (const j of jobs) {\n    results.push({\n      json: {\n        ...j,\n        company: meta.note || meta.token,\n        source_platform: meta.platform,\n      },\n    });\n  }\n}\n\nreturn results;"
      },
